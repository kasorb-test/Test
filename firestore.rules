rules_version = '2';

// KASORB TEST — Firestore Security Rules
// วางไฟล์นี้ใน Firebase Console > Firestore Database > Rules แล้วกด Publish
//
// - สมาชิกอ่าน/แก้ได้เฉพาะเอกสารของตัวเอง
// - สมาชิกแก้ได้แค่ ชื่อเล่น คติ รูป (การ์ตูนหรืออัปโหลด) เพศ (plan / xp / level / score / role แก้เองไม่ได้)
// - ชื่อเล่นเปลี่ยนได้ทุก 30 วัน
// - แอดมินอ่านรายชื่อทั้งหมด และเปิด/ปิดสิทธิ์ premium ได้

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "thananitwit@gmail.com";
    }

    // เหรียญพิเศษที่แอดมินตั้งไว้ใน site/coins: เก็บได้เฉพาะช่วงเวลาที่กำหนด ช่วงละครั้ง ได้ตามจำนวนที่ตั้งไว้
    function coinSite() {
      return get(/databases/$(database)/documents/site/coins).data;
    }
    function validClaim(n, o) {
      let drops = coinSite().drops;
      let before = o.get("claimed", {});
      let d = drops[n.lastClaim];
      return n.lastClaim is string && n.lastClaim in drops
        && !(n.lastClaim in before)
        && n.claimed is map
        && n.claimed.keys().hasOnly(before.keys().concat([n.lastClaim]))
        && n.claimed.keys().hasAll(before.keys().concat([n.lastClaim]))
        && request.time.toMillis() >= d.start && request.time.toMillis() <= d.end
        && n.get("coins", 0) == o.get("coins", 0) + d.amount
        && !n.diff(o).affectedKeys().hasAny(["owned", "lastBuy", "coupons", "lastCoupon"]);
    }
    // แลกโค้ดส่วนลด: เพิ่มโค้ดใหม่ครั้งละ 1 โค้ด ราคาและจำนวนบาทตรงกับที่แอดมินตั้งไว้ โค้ดเดิมแก้ไม่ได้
    function validCoupon(n, o) {
      let cps = coinSite().coupons;
      let before = o.get("coupons", {});
      let c = n.coupons[n.lastCoupon];
      return n.lastCoupon is string && n.lastCoupon.matches("KS[A-Z0-9]{6}")
        && !(n.lastCoupon in before)
        && n.coupons is map
        && n.coupons.diff(before).affectedKeys().hasOnly([n.lastCoupon])
        && n.coupons.diff(before).addedKeys().hasOnly([n.lastCoupon])
        && c.keys().hasOnly(["cid", "baht", "name", "used", "at"])
        && c.cid is string && c.cid in cps
        && c.baht == cps[c.cid].baht && c.used == false
        && c.name is string && c.name.size() <= 40 && c.at is int
        && n.get("coins", 0) == o.get("coins", 0) - cps[c.cid].coins
        && n.get("coins", 0) >= 0
        && !n.diff(o).affectedKeys().hasAny(["owned", "lastBuy", "claimed", "lastClaim"]);
    }
    // แลกของสะสม: เพิ่มได้ครั้งละ 1 ชิ้น (lastBuy) หักเหรียญตามราคา และต้องมีเหรียญพอ
    function validBuy(n, o) {
      let prices = {"badge": 30, "whistle": 40, "pencil": 50, "cap": 60, "medal": 80, "book": 100,
                    "star": 120, "trophy": 150, "shield": 200, "crown": 250, "gem": 300, "rocket": 400};
      let before = o.get("owned", {});
      return n.lastBuy is string && n.lastBuy in prices
        && !(n.lastBuy in before)
        && n.owned is map && n.owned.keys().hasOnly(before.keys().concat([n.lastBuy]))
        && n.owned.keys().hasAll(before.keys().concat([n.lastBuy]))
        && n.owned[n.lastBuy] == true
        && n.get("coins", 0) == o.get("coins", 0) - prices[n.lastBuy]
        && n.get("coins", 0) >= 0
        && !n.diff(o).affectedKeys().hasAny(["claimed", "lastClaim", "coupons", "lastCoupon"]);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ใช้ get() พร้อมค่าเริ่มต้น เผื่อเอกสารเก่าที่ไม่มีบางฟิลด์
    function validProfileText(data) {
      return data.get("nickname", "") is string
        && data.get("nickname", "").size() > 0 && data.get("nickname", "").size() <= 20
        && data.get("quote", "") is string && data.get("quote", "").size() <= 50
        && data.get("gender", "unspecified") in ["male", "female", "unspecified"]
        && data.get("avatar", "avatar20.png") is string
        && data.get("avatar", "avatar20.png").matches("avatar[0-9]{2}[.]png")
        && validPhoto(data);
    }

    // รูปที่นักเรียนอัปโหลด: รูป JPEG ขนาดเล็ก เก็บเป็นข้อความ ("" = ไม่มีรูป)
    function validPhoto(data) {
      return data.get("photo", "") is string
        && (data.get("photo", "") == ""
            || (data.get("photo", "").size() <= 60000
                && data.get("photo", "").matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")));
    }

    // ข้อมูลหน้าหลัก (วันสอบ ข่าวสาร ข้อสอบประจำวัน สถิติ) — ทุกคนอ่านได้ แอดมินแก้ได้
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // รูปข่าวที่แอดมินอัปโหลด — ทุกคนอ่านได้ แอดมินเพิ่ม/ลบได้
    match /siteImg/{key} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null
            || (request.resource.data.keys().hasOnly(["d"])
                && request.resource.data.d is string
                && request.resource.data.d.size() <= 750000
                && request.resource.data.d.matches("data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+")));
    }

    // สถานะออนไลน์ สำหรับนับ "กำลังใช้งาน" — สมาชิกเขียนได้เฉพาะของตัวเอง เก็บแค่เวลาล่าสุด
    // จำนวนข้อที่ทำในวันนี้ของแต่ละคน ใช้รวมเป็น "ทำแบบทดสอบแล้ววันนี้" ของทั้งเว็บ
    match /todayCount/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["date", "count"])
        && request.resource.data.date is string
        && request.resource.data.date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 2000;
    }

    // กระดานอันดับ XP: ทุกคนเห็น เจ้าของเขียนของตัวเอง XP ต้องตรงกับในบัญชี
    match /board/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["name", "avatar", "lv", "quote", "xp"])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.avatar is string && request.resource.data.avatar.matches("avatar[0-9]{2}[.]png")
        && request.resource.data.lv is string && request.resource.data.lv.size() <= 40
        && request.resource.data.quote is string && request.resource.data.quote.size() <= 80
        && request.resource.data.xp == get(/databases/$(database)/documents/users/$(uid)).data.get("xp", 0);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["lastSeen"])
        && request.resource.data.lastSeen == request.time;
    }

    // อุปกรณ์: ผูกได้ 2 เครื่อง ใช้ได้ทีละเครื่อง (active) เครื่องชนิดเดียวกันแทนที่กันเองได้ นอกนั้นแอดมินลบให้
    function validDevices(d) {
      // lastSwapAt: ฟิลด์จากเวอร์ชันก่อน เก็บไว้ไม่ให้เอกสารเก่าบันทึกไม่ได้
      // replaced: id ของเครื่องเดิมที่ถูกแทนที่ด้วยเครื่องชนิดเดียวกัน
      return d.keys().hasOnly(["ids", "active", "activeAt", "lastSwapAt", "replaced"])
        && d.ids is map
        && d.ids.keys().size() >= 1 && d.ids.keys().size() <= 2
        // active = เครื่องที่ล็อกอินล่าสุด (null หลังแอดมินลบเครื่องที่ใช้งานอยู่)
        && (d.get("active", null) == null || d.active in d.ids.keys());
    }

    match /devices/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validDevices(request.resource.data);
      // เจ้าของสลับเครื่องที่ใช้งาน หรือเพิ่มเครื่องที่ 2 ได้ แต่ลบ/แทนที่เครื่องเดิมไม่ได้
      allow update: if isOwner(uid) && validDevices(request.resource.data)
        && request.resource.data.ids.keys().hasAll(resource.data.ids.keys());
      // ครบ 2 เครื่องแล้ว: เครื่องใหม่แทนที่เครื่องเดิมที่ชื่อชนิดเดียวกันได้ 1 เครื่อง (เช่น iPad · Safari)
      allow update: if isOwner(uid) && validDevices(request.resource.data)
        && request.resource.data.get("replaced", "") is string
        && request.resource.data.replaced in resource.data.ids
        && !(request.resource.data.replaced in request.resource.data.ids)
        && request.resource.data.active in request.resource.data.ids
        && !(request.resource.data.active in resource.data.ids)
        && request.resource.data.ids.keys().size() == resource.data.ids.keys().size()
        && request.resource.data.ids.keys().hasAll(
             resource.data.ids.keys().removeAll([request.resource.data.replaced]))
        && resource.data.ids[request.resource.data.replaced].name
             == request.resource.data.ids[request.resource.data.active].name;
      // แอดมินลบบางเครื่อง หรือลบทั้งหมดได้
      allow update: if isAdmin() && validDevices(request.resource.data);
      allow delete: if isAdmin();
    }

    function isPremium() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("plan", "free") == "premium";
    }

    // ตัวนับลำดับสมาชิก (รหัส #วันที่สมัคร+ลำดับ): เพิ่มทีละ 1 พร้อมกับบันทึกเลขในบัญชีของตัวเองเท่านั้น
    match /counters/member {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        || (request.auth != null
            && request.resource.data.keys().hasOnly(["n"])
            && request.resource.data.n == (resource == null ? 0 : resource.data.get("n", 0)) + 1
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("memberNo", 0) == request.resource.data.n);
    }

    // ชุดข้อสอบ: ทุกคนที่ล็อกอินเห็นรายชื่อชุด แอดมินเพิ่ม/แก้/ลบ
    match /exams/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // เปิดชุดข้อสอบได้เมื่อ: เผยแพร่แล้ว และ (ชุดฟรี / สมาชิกพรีเมียม / ซื้อวิชานั้นแยก)
    function canOpenExam(id) {
      let e = get(/databases/$(database)/documents/exams/$(id)).data;
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
        && e.get("published", true) == true
        && (e.get("tier", "premium") == "free"
            || u.get("plan", "free") == "premium"
            || (e.get("kind", "") == "subject" && e.get("subject", "") in u.get("subjects", [])));
    }

    // ตัวข้อสอบ เฉลย คำอธิบาย
    match /examItems/{id} {
      allow read: if isAdmin() || canOpenExam(id);
      allow write: if isAdmin();
    }

    // รูปประกอบข้อสอบและคำอธิบาย: สิทธิ์เดียวกับตัวข้อสอบของชุดนั้น
    match /examImg/{key} {
      allow read: if isAdmin() || canOpenExam(resource.data.exam);
      allow write: if isAdmin();
    }

    // ประวัติคำตอบรายข้อ (ใช้คิด XP และความคืบหน้า): เจ้าของเท่านั้น
    match /progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["h", "best", "keyVer", "updatedAt"])
        && request.resource.data.h is map
        && request.resource.data.best is map;
    }

    match /users/{uid} {

      // ประวัติการทำข้อสอบแต่ละครั้ง
      match /attempts/{aid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.total is int
          && request.resource.data.correct is int
          && request.resource.data.correct <= request.resource.data.total;
      }


      allow read: if isOwner(uid) || isAdmin();

      // สมัครสมาชิก: เริ่มต้นเป็นสมาชิกฟรีเสมอ
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             "email", "nickname", "quote", "gender", "avatar", "role", "plan",
             "active", "level", "score", "xp", "nicknameChangedAt", "createdAt"
           ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.plan == "free"
        && request.resource.data.active == false
        && request.resource.data.level == 0
        && request.resource.data.score == 0
        && request.resource.data.xp == 0
        && request.resource.data.nicknameChangedAt == null
        && validProfileText(request.resource.data);

      // สมาชิกแก้โปรไฟล์ตัวเอง
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["nickname", "nicknameChangedAt", "quote", "gender", "avatar", "photo", "today", "xp", "answered", "memberNo", "memberDate", "items", "village", "plot", "villageHidden", "coins", "claimed", "lastClaim", "owned", "lastBuy", "coupons", "lastCoupon"])
        // รหัสสมาชิก: ตั้งได้ครั้งเดียว และต้องตรงกับตัวนับที่เพิ่งเพิ่มในคำสั่งเดียวกัน
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["memberDate"])
            || (request.resource.data.memberDate is string
                && request.resource.data.memberDate.matches("[0-9]{6}")
                && resource.data.get("memberDate", null) == null))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["memberNo"])
            || (resource.data.get("memberNo", null) == null
                && request.resource.data.memberNo is int
                && getAfter(/databases/$(database)/documents/counters/member).data.n == request.resource.data.memberNo
                && (exists(/databases/$(database)/documents/counters/member)
                      ? get(/databases/$(database)/documents/counters/member).data.n + 1
                      : 1) == request.resource.data.memberNo))
        // XP เพิ่มได้ครั้งละไม่เกิน 1 ชุด (150 ข้อ x 40) และลดได้เมื่อแก้เฉลย, จำนวนข้อที่ทำแล้วไม่เกิน 20,000
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["xp"])
            || (request.resource.data.xp is int && request.resource.data.xp >= 0
                && request.resource.data.xp <= resource.data.get("xp", 0) + 6000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["answered"])
            || (request.resource.data.answered is int && request.resource.data.answered >= 0
                && request.resource.data.answered <= 20000))
        // เหรียญ: เปลี่ยนได้ 3 ทางเท่านั้น คือเก็บเหรียญพิเศษ แลกของสะสม และแลกโค้ดส่วนลด
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["claimed", "lastClaim"])
            || validClaim(request.resource.data, resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["owned", "lastBuy"])
            || validBuy(request.resource.data, resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["coupons", "lastCoupon"])
            || validCoupon(request.resource.data, resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["coins"])
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastClaim", "lastBuy", "lastCoupon"]))
        // หมู่บ้าน: รหัสหมู่บ้าน เลขบ้าน 0-19 ต้องเป็นหลังที่ตัวเองจองไว้ในคำสั่งเดียวกัน
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["village", "plot"])
            || (request.resource.data.village is string && request.resource.data.village.matches("v[0-9a-z]{4,20}")
                && request.resource.data.plot is int && request.resource.data.plot >= 0 && request.resource.data.plot < 20
                && getAfter(/databases/$(database)/documents/villages/$(request.resource.data.village)/slots/$(string(request.resource.data.plot))).data.uid == uid))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["villageHidden"])
            || request.resource.data.villageHidden is bool)
        // ไอเทมแต่งบ้าน: ได้ 1 ชิ้นต่อทุก 20 ข้อที่ทำ (สูงสุด 12 ชิ้น)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["items"])
            || (request.resource.data.items is list
                && request.resource.data.items.size() <= 12
                && request.resource.data.items.size() <= request.resource.data.get("answered", 0) / 20 + 1))
        && validProfileText(request.resource.data)
        // วันนี้ทำข้อสอบไปกี่ข้อ: {date: "YYYY-MM-DD", count: 0-2000}
        // daily / dailyChoice: ข้อสอบประจำวันที่ตอบแล้ว (กันนับซ้ำเมื่อเปิดหลายเครื่อง)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["today"])
          || (
            request.resource.data.today.keys().hasOnly(["date", "count", "daily", "dailyChoice"])
            && request.resource.data.today.get("daily", "") is string
            && request.resource.data.today.get("daily", "").size() <= 60
            && request.resource.data.today.get("dailyChoice", 0) is int
            && request.resource.data.today.date is string
            && request.resource.data.today.count is int
            && request.resource.data.today.count >= 0
            && request.resource.data.today.count <= 2000
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(["nickname", "nicknameChangedAt"])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAll(["nickname", "nicknameChangedAt"])
            && request.resource.data.nicknameChangedAt == request.time
            && (
              resource.data.get("nicknameChangedAt", null) == null
              || request.time > resource.data.nicknameChangedAt + duration.value(30, "d")
            )
          )
        );

      // แอดมินเลือกแพ็กเกจ: ฟรี / รายปี (มีวันหมดอายุ) / ตลอดชีพ
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["plan", "planType", "premiumUntil"])
        && request.resource.data.plan in ["free", "premium"]
        && request.resource.data.get("planType", null) in [null, "yearly", "lifetime"]
        && (request.resource.data.get("premiumUntil", null) == null
            || request.resource.data.premiumUntil is string);

      // แอดมินเลือกวิชาที่สมาชิกซื้อแยก (ขายรายวิชา)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["subjects"])
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 20;

      // แอดมินออกรหัสสมาชิกให้สมาชิกเดิม
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberNo", "memberDate"])
        && request.resource.data.get("memberNo", 1) is int && request.resource.data.get("memberNo", 1) > 0
        && request.resource.data.get("memberDate", "000000").matches("[0-9]{6}");

      // แอดมินกดว่าโค้ดส่วนลดใช้แล้ว (แก้ได้เฉพาะสถานะ used ของโค้ดที่มีอยู่)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["coupons"])
        && request.resource.data.coupons.keys().hasOnly(resource.data.get("coupons", {}).keys())
        && resource.data.get("coupons", {}).keys().hasOnly(request.resource.data.coupons.keys());

      // แอดมินลบรูปที่ไม่เหมาะสม (กลับไปใช้รูปการ์ตูน)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photo"])
        && request.resource.data.photo == "";

      allow delete: if false;
    }

    // ===== หมู่บ้านกะสอบ: หมู่บ้านละ 20 หลัง เห็นหน้าบ้านกันได้ เข้าบ้านคนอื่นไม่ได้ =====
    match /villages/{vid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && vid.matches("v[0-9a-z]{4,20}")
        && request.resource.data.keys().hasOnly(["name", "n", "createdAt"])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.n == 1;
      // จำนวนคนในหมู่บ้าน เพิ่ม/ลดทีละ 1 ตอนย้ายเข้า-ออก
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["n"])
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 20
        && (request.resource.data.n == resource.data.n + 1 || request.resource.data.n == resource.data.n - 1);

      // จองเลขบ้าน: เลขละ 1 คน จองซ้ำไม่ได้ ลบได้เฉพาะของตัวเอง
      match /slots/{s} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && s.matches("[0-9]|1[0-9]")
          && request.resource.data.keys().hasOnly(["uid"])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // หน้าบ้าน: ชื่อ ยศ รูปเล็ก ของแต่งบ้าน แก้ได้เฉพาะเจ้าของ และต้องเป็นหลังที่ตัวเองจองไว้
      match /plots/{uid} {
        allow read: if request.auth != null;
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(["slot", "nickname", "lv", "rank", "avatar", "photo", "items", "hidden", "seen"])
          && request.resource.data.slot is int && request.resource.data.slot >= 0 && request.resource.data.slot < 20
          && get(/databases/$(database)/documents/villages/$(vid)/slots/$(string(request.resource.data.slot))).data.uid == uid
          && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 20
          && request.resource.data.lv is int && request.resource.data.lv >= 0 && request.resource.data.lv <= 18
          && request.resource.data.rank is string && request.resource.data.rank.size() <= 30
          && request.resource.data.avatar is string && request.resource.data.avatar.matches("avatar[0-9]{2}[.]png")
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 20000
          && request.resource.data.items is list && request.resource.data.items.size() <= 12
          && request.resource.data.hidden is bool
          && request.resource.data.seen is int;
        allow delete: if isOwner(uid);
      }
    }
  }
}
